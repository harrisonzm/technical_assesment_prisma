# Aplicación
APP_NAME=technical_assesment_prisma
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
SERVICE_NAME=backend

# Servidor
HOST=0.0.0.0
PORT=8000

# Seguridad
SECRET_KEY=replace-with-a-strong-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Base de datos
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://app_user:change_me@db:5432/app_db

# Logs y consumidor
LOG_FILE_PATH=/var/log/technical_assessment_prisma/backend.log
CONSUMER_API_URL=http://backend:8000/api/v1
CONSUMER_TIMEOUT_SECONDS=5
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_SECONDS=1
CONSUMER_BATCH_SIZE=3
