# Aplicación
APP_NAME=technical_assesment_prisma
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
SERVICE_NAME=backend

# Servidor
HOST=0.0.0.0
PORT=8000

# Rendimiento HTTP
GZIP_MINIMUM_SIZE=500
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=0.2
CACHE_TTL_SECONDS=30
CACHE_KEY_PREFIX=technical-assessment:http-cache
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=technical-assessment:rate-limit
REQUEST_MAX_CONCURRENCY=50
REQUEST_QUEUE_SIZE=100
REQUEST_QUEUE_TIMEOUT_SECONDS=10

# Seguridad
SECRET_KEY=replace-with-a-strong-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Base de datos
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://app_user:change_me@db:5432/app_db

# Logs y consumidor
LOG_FILE_PATH=/var/log/technical_assessment_prisma/backend.log
CONSUMER_API_URL=http://backend:8000/api/v1
CONSUMER_TIMEOUT_SECONDS=5
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_DELAY_SECONDS=1
CONSUMER_BATCH_SIZE=3
